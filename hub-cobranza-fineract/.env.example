# Puerto expuesto en tu máquina para Collection Hub
SERVER_PORT=8080

# Conexión a MariaDB (base hub_cobranza en contenedor fineract-mariadb)
DB_HOST=fineract-mariadb
DB_PORT=3306
DB_NAME=hub_cobranza
DB_USER=root
DB_PASSWORD=rootpass

# Conexión hacia Apache Fineract 1.12.1 en la red interna Docker
FINERACT_BASE_URL=https://apache-fineract:8443/fineract-provider/api/v1
FINERACT_TENANT_ID=default
FINERACT_USERNAME=mifos
FINERACT_PASSWORD=password
FINERACT_CONNECT_TIMEOUT_MS=5000
FINERACT_READ_TIMEOUT_MS=15000
FINERACT_INSECURE_SSL=true